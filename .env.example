# Copia a .env y ajusta. Ninguna de estas variables es obligatoria.

# --- cerebro de los agentes ---
# scripted = determinista, sin red, sin clave (por defecto)
# anthropic = genera el código con un LLM real
BRAIN=scripted
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- despliegue ---
# En false, el DeployAgent registra el comando pero NO despliega.
# Ponlo en true solo cuando quieras un despliegue real a producción.
DEPLOY_ENABLED=false
# VERCEL_TOKEN=...
# DEPLOY_TIMEOUT_S=600

# --- otros ---
# ORIGENES_PERMITIDOS=http://localhost:3000
