# Copia a .env y ajusta. Ninguna de estas variables es obligatoria.

# --- cerebro de los agentes ---
# scripted = determinista, sin red, sin clave (por defecto)
# anthropic = genera el código con un LLM real vía API key (se factura por token)
# claude-cli = delega en el CLI de Claude Code ya logueado en esta máquina
#   (`claude -p`), sin API key propia. Solo sirve en desarrollo local: un
#   backend desplegado no tiene esa sesión logueada.
BRAIN=scripted
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
# CLAUDE_CLI_COMANDO=claude
# CLAUDE_CLI_TIMEOUT_S=300

# --- despliegue ---
# En false, la etapa de Despliegue de la fábrica informa los comandos git/gh
# que correría, pero NO publica nada. Ponlo en true solo cuando quieras que
# cada encargo aprobado abra un PR real (ver GITHUB_REPO más abajo).
DEPLOY_ENABLED=false
# VERCEL_TOKEN=...

# --- conexión OAuth con Vercel (botón "Conectar con Vercel" en /configuracion) ---
# Se consiguen registrando una integración en vercel.com/dashboard →
# Integrations Console. Ver la sección "Conectar con Vercel" del README para
# el paso a paso completo.
# VERCEL_CLIENT_ID=...
# VERCEL_CLIENT_SECRET=...
# VERCEL_INTEGRATION_SLUG=...
# VERCEL_OAUTH_REDIRECT_URI=http://localhost:8000/api/vercel/oauth/callback

# --- conexión con Render ---
# El nombre del servicio que buscar en tu cuenta de Render al conectar
# (tiene que coincidir con el `name` en backend/render.yaml).
# RENDER_SERVICE_NAME=orquesta-backend

# --- otros ---
# ORIGENES_PERMITIDOS=http://localhost:3000

# --- proveedor compatible con OpenAI (BRAIN=openai-compatible) ---
# DeepSeek por defecto: modelos más baratos para etapas bien acotadas.
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_BASE_URL=https://api.deepseek.com
# OPENAI_COMPAT_MODELO=deepseek-chat
# Precio por millón de tokens [entrada, salida] de modelos fuera de la tabla
# de Claude (backend/app/adaptadores/tarifas.py). Verifícalo con tu proveedor.
# TARIFAS_EXTRA={"deepseek-chat": [0.27, 1.10]}

# --- fábrica de software (/fabrica) ---
# Modelo por rol; vacío = el modelo por defecto del proveedor activo.
# FABRICA_MODELO_ESPECIFICADOR=claude-haiku-4-5
# FABRICA_MODELO_IMPLEMENTADOR=
# FABRICA_MODELO_REVISOR=claude-haiku-4-5
# FABRICA_MODELO_DIAGNOSTICADOR=claude-haiku-4-5
# FABRICA_MAX_INTENTOS=2
# FABRICA_PRESUPUESTO_USD=1.0
# nunca | ambiguedad | siempre
# FABRICA_APROBACION_HUMANA=ambiguedad
# local | docker  (con un cerebro real, docker: el código generado corre sin red)
# FABRICA_SANDBOX=local
# FABRICA_IMAGEN_SANDBOX=orquesta-sandbox:latest
# FABRICA_E2E_ENABLED=false
# FABRICA_IMAGEN_E2E=mcr.microsoft.com/playwright:v1.55.0-noble
# FABRICA_E2E_URL_BASE=http://host.docker.internal:3000
# Despliegue de encargos vía PR + GitHub Actions (solo con DEPLOY_ENABLED=true).
# GITHUB_REPO=dueño/repositorio
# GITHUB_RAMA_BASE=main
# Caché de respuestas del LLM: un prompt idéntico no se paga dos veces.
# FABRICA_CACHE_LLM=false
# Plugins de ciclo de vida (archivos .py; los que empiezan con "_" no se cargan).
# FABRICA_DIR_PLUGINS=backend/plugins
# Tope de caracteres del contexto por etapa; por encima se compacta.
# FABRICA_LIMITE_CONTEXTO=60000
# Especificaciones de un mismo nivel de dependencias construyéndose a la vez.
# FABRICA_PARALELISMO=3
# local | prefect  (prefect: flow run por encargo y task run por etapa en la
# UI de Prefect; requiere pip install -r backend/requirements-prefect.txt)
# FABRICA_ORQUESTADOR=local
# PREFECT_UI_URL=http://127.0.0.1:4200
